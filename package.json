{
  "name": "aida-native-probe-capacitor",
  "version": "0.1.0",
  "description": "AIDA native probe: device info and one raw gyroscope sample (Capacitor side of a dual-stack plugin).",
  "license": "UNLICENSED",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "AidaNativeProbeCapacitor.podspec"
  ],
  "keywords": [
